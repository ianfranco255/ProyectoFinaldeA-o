using System;
using System.Runtime.InteropServices;
using System.Threading;
namespace JuegoAsteroides
{
    internal struct Vector2
    {
        public int X;
        public int Y;

        public Vector2(int x, int y)
        {
            X = x;
            Y = y;
        }
    }

    internal struct Nave
    {
        public Vector2 Posicion;
    }

    internal struct Bala
    {
        public Vector2 Posicion;
        public bool Activa;
    }

    internal struct PantallaConfig
    {
        public int AnchoConsola;
        public int AltoConsola;
    }

    internal struct EstadoJuego
    {
        public bool Jugando;
        public PantallaConfig Pantalla;
        public Nave Jugador;
        public Bala Proyectil;
    }

    internal struct Program
    {
        [DllImport("user32.dll")]
        private static extern IntPtr GetSystemMenu(IntPtr hWnd, bool bRevert);

        [DllImport("user32.dll")]
        private static extern bool DeleteMenu(IntPtr hMenu, uint uPosition, uint uFlags);

        [DllImport("kernel32.dll")]
        private static extern IntPtr GetConsoleWindow();

        private const uint SC_SIZE = 0xF000;

        private static EstadoJuego _estado;

        // Límites del mapa lógico de referencia
        private const int ANCHO_VIRTUAL = 100;
        private const int ALTO_VIRTUAL = 100;

        static void Main(string[] args)
        {
            BloquearRedimensionamientoMouse();
            ConfigurarConsola();

            while (_estado.Jugando)
            {
                VerificarCambioTamaño();
                ProcesarEntrada();
                ActualizarJuego();

                // Un pequeño delay para no saturar el procesador en el bucle de lectura
                Thread.Sleep(10);
            }
        }

        static void BloquearRedimensionamientoMouse()
        {
            IntPtr handleVentana = GetConsoleWindow();
            IntPtr handleMenu = GetSystemMenu(handleVentana, false);
            DeleteMenu(handleMenu, SC_SIZE, 0x00000000);
        }

        static void ConfigurarConsola()
        {
            Console.Title = "Asteroids - Registro de Telemetría y Coordenadas";
            Console.CursorVisible = true;
            Console.Clear();

            _estado.Jugando = true;
            _estado.Jugador.Posicion = new Vector2(50, 85);
            _estado.Proyectil.Activa = false;

            _estado.Pantalla.AnchoConsola = Console.WindowWidth;
            _estado.Pantalla.AltoConsola = Console.WindowHeight;

            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.WriteLine("==================================================================");
            Console.WriteLine("SISTEMA DE TELEMETRÍA INICIADO - CONTROL DE COORDENADAS VIRTUALES");
            Console.WriteLine("Controles: WASD (Mover Referencia) | F (Disparar) | ESC (Salir)");
            Console.WriteLine($"Dimensiones del Mapa de Referencia: {ANCHO_VIRTUAL}x{ALTO_VIRTUAL}");
            Console.WriteLine("==================================================================");
            Console.ResetColor();
            Console.WriteLine();

            // Mostrar estado inicial
            ImprimirLog("INICIALIZACIÓN", _estado.Jugador.Posicion.X, _estado.Jugador.Posicion.Y);
        }

        static void VerificarCambioTamaño()
        {
            if (Console.WindowWidth != _estado.Pantalla.AnchoConsola ||
                Console.WindowHeight != _estado.Pantalla.AltoConsola)
            {
                _estado.Pantalla.AnchoConsola = Console.WindowWidth;
                _estado.Pantalla.AltoConsola = Console.WindowHeight;

                Console.ForegroundColor = ConsoleColor.DarkGray;
                Console.WriteLine($"[NOTIFICACIÓN] Ventana redimensionada a: {_estado.Pantalla.AnchoConsola}x{_estado.Pantalla.AltoConsola}");
                Console.ResetColor();
            }
        }

        static void ProcesarEntrada()
        {
            if (Console.KeyAvailable)
            {
                ConsoleKeyInfo tecla = Console.ReadKey(true);

                if (tecla.Key == ConsoleKey.Escape) _estado.Jugando = false;

                int pasoX = 4;
                int pasoY = 4;
                string instruccion = "";

                if (tecla.Key == ConsoleKey.W)
                {
                    _estado.Jugador.Posicion.Y -= pasoY;
                    instruccion = "COMANDO 'W' (ARRIBA)";
                }
                if (tecla.Key == ConsoleKey.S)
                {
                    _estado.Jugador.Posicion.Y += pasoY;
                    instruccion = "COMANDO 'S' (ABAJO)";
                }
                if (tecla.Key == ConsoleKey.A)
                {
                    _estado.Jugador.Posicion.X -= pasoX;
                    instruccion = "COMANDO 'A' (IZQUIERDA)";
                }
                if (tecla.Key == ConsoleKey.D)
                {
                    _estado.Jugador.Posicion.X += pasoX;
                    instruccion = "COMANDO 'D' (DERECHA)";
                }

                // Restricción matemática estricta sobre el universo virtual (0 a 100)
                if (_estado.Jugador.Posicion.X < 0) _estado.Jugador.Posicion.X = 0;
                if (_estado.Jugador.Posicion.X > ANCHO_VIRTUAL) _estado.Jugador.Posicion.X = ANCHO_VIRTUAL;
                if (_estado.Jugador.Posicion.Y < 0) _estado.Jugador.Posicion.Y = 0;
                if (_estado.Jugador.Posicion.Y > ALTO_VIRTUAL) _estado.Jugador.Posicion.Y = ALTO_VIRTUAL;

                // Si se presionó una tecla de movimiento, imprimir su registro inmediatamente
                if (instruccion != "")
                {
                    ImprimirLog(instruccion, _estado.Jugador.Posicion.X, _estado.Jugador.Posicion.Y);
                }

                // Disparar con F
                if (tecla.Key == ConsoleKey.F)
                {
                    _estado.Proyectil.Activa = true;
                    _estado.Proyectil.Posicion = new Vector2(_estado.Jugador.Posicion.X, _estado.Jugador.Posicion.Y);

                    Console.ForegroundColor = ConsoleColor.DarkYellow;
                    Console.WriteLine($"[{DateTime.Now:HH:mm:ss.fff}] ACCIÓN: COMANDO 'F' (DISPARAR BALA) -> Origen Referencia X: {_estado.Proyectil.Posicion.X}, Y: {_estado.Proyectil.Posicion.Y}");
                    Console.ResetColor();
                }
            }
        }

        static void ActualizarJuego()
        {
            // La lógica matemática sigue corriendo en segundo plano sin alterar el flujo del texto
            if (_estado.Proyectil.Activa)
            {
                _estado.Proyectil.Posicion.Y -= 8; // La bala avanza en el espacio virtual

                if (_estado.Proyectil.Posicion.Y < 0)
                {
                    _estado.Proyectil.Activa = false;
                    Console.ForegroundColor = ConsoleColor.DarkGray;
                    Console.WriteLine($"[{DateTime.Now:HH:mm:ss.fff}] TELEMETRÍA: Bala fuera de rango (Y < 0). Destrucción de proyectil.");
                    Console.ResetColor();
                }
            }
        }

        static void ImprimirLog(string instruccion, int x, int y)
        {
            // Imprime la marca de tiempo, la acción ejecutada y el estado actual de las coordenadas
            Console.WriteLine($"[{DateTime.Now:HH:mm:ss.fff}] ACCIÓN: {instruccion} -> Nueva Coordenada Referencia X: {x}, Y: {y}");
        }
    }
}
